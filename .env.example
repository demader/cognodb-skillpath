# CognoDB Cloud connection details.
# Create a free instance at https://console.cognodb.com, then copy its
# bolt+s:// URI and the generated "cognodb" user password here.
# Copy this file to .env.local and fill in your own values — .env.local is gitignored.

NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.com
NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=<your-generated-password>
